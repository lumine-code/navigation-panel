{
  "name": "navigation-panel",
  "author": "lumine-code",
  "description": "Document outline and navigation panel.",
  "repository": "https://github.com/lumine-code/navigation-panel",
  "bugs": {
    "url": "https://github.com/lumine-code/navigation-panel/issues"
  },
  "keywords": [
    "outline",
    "section",
    "toc",
    "folding",
    "marker",
    "bookmark"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../navigation-panel/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lumine-code/etch": "https://github.com/lumine-code/etch.git#ace74599f9d6b54e9eb24ecb1e2407e9c35fcc74",
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "providedServices": {
    "navigation.headers": {
      "versions": {
        "1.0.0": "provideNavigationHeaders"
      }
    }
  },
  "consumedServices": {
    "navigation.adapter": {
      "versions": {
        "^1.0.0": "consumeNavigationAdapter"
      }
    }
  },
  "configSchema": {
    "panel": {
      "title": "Panel",
      "description": "Panel display and behavior settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "defaultSide": {
          "title": "Default side",
          "description": "Which side the panel opens on. Restart needed.",
          "type": "string",
          "enum": [
            {
              "description": "Left",
              "value": "left"
            },
            {
              "description": "Right",
              "value": "right"
            }
          ],
          "default": "left"
        },
        "visibility": {
          "title": "Visibility mode",
          "description": "Default tree expand/collapse behavior. Can also be changed via command or panel context menu.",
          "type": "integer",
          "enum": [
            {
              "description": "Collapsed",
              "value": 0
            },
            {
              "description": "Expanded",
              "value": 1
            },
            {
              "description": "Auto-collapse",
              "value": 2
            }
          ],
          "default": 1
        },
        "traceVisible": {
          "title": "Trace visible headers",
          "description": "Highlight headers visible in the editor viewport and scroll the panel to follow.",
          "type": "boolean",
          "default": true
        },
        "searchBar": {
          "title": "Show search bar",
          "description": "Show the search bar at the top of the panel. Restart needed.",
          "type": "boolean",
          "default": true
        },
        "categoryBar": {
          "title": "Show category bar",
          "description": "Show the category filter bar at the bottom of the panel. Restart needed.",
          "type": "boolean",
          "default": true
        },
        "textWrap": {
          "title": "Wrap text",
          "description": "Wrap long header text instead of showing a horizontal scrollbar. Restart needed.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "editor": {
      "title": "Editor",
      "description": "Editor navigation and marker settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "markLines": {
          "title": "Mark section lines",
          "description": "Decorate section lines in the gutter or text. Style can be customized in `styles.less`. Restart needed.",
          "type": "boolean",
          "default": true
        },
        "markerUserLevel": {
          "title": "User-level marker colors",
          "description": "Use the user-assigned section level for marker color instead of the real level. Restart needed.",
          "type": "boolean",
          "default": false
        },
        "markerType": {
          "title": "Marker type",
          "description": "Which parts of the line to decorate. Restart needed.",
          "type": "string",
          "enum": [
            {
              "description": "Line",
              "value": "line"
            },
            {
              "description": "Line number",
              "value": "line-number"
            },
            {
              "description": "Text",
              "value": "text"
            },
            {
              "description": "Line & line number",
              "value": "line&line-number"
            },
            {
              "description": "Text & line number",
              "value": "text&line-number"
            }
          ],
          "default": "line"
        },
        "scrollPosition": {
          "title": "Scroll position",
          "description": "Scroll zone as % of viewport height. Single value e.g. `25` always scrolls cursor to that position. Two values e.g. `10-75` define a lazy zone — scrolls only when cursor leaves it. 0 = top, 100 = bottom.",
          "type": "string",
          "default": "0-50"
        },
        "maxHeadingDepth": {
          "title": "Max heading depth",
          "description": "Maximum section level to include in the outline (real level, not user level). Refocus needed.",
          "type": "integer",
          "minimum": 1,
          "default": 9
        }
      }
    },
    "scanners": {
      "title": "Scanners",
      "description": "Enable or disable individual built-in language scanners.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "asciidoc": {
          "title": "AsciiDoc",
          "type": "boolean",
          "default": true
        },
        "bibtex": {
          "title": "BibTeX",
          "type": "boolean",
          "default": true
        },
        "clike": {
          "title": "C / C# / C++",
          "type": "boolean",
          "default": true
        },
        "javascript": {
          "title": "JavaScript / TypeScript",
          "type": "boolean",
          "default": true
        },
        "latex": {
          "title": "LaTeX",
          "type": "boolean",
          "default": true
        },
        "markdown": {
          "title": "Markdown",
          "type": "boolean",
          "default": true
        },
        "python": {
          "title": "Python",
          "type": "boolean",
          "default": true
        },
        "rest": {
          "title": "reStructuredText",
          "type": "boolean",
          "default": true
        },
        "sinumerik": {
          "title": "Sinumerik",
          "type": "boolean",
          "default": true
        },
        "sofistik": {
          "title": "SOFiSTiK",
          "type": "boolean",
          "default": true
        },
        "tasklist": {
          "title": "Tasklist",
          "type": "boolean",
          "default": true
        },
        "typst": {
          "title": "Typst",
          "type": "boolean",
          "default": true
        }
      }
    },
    "latex": {
      "title": "LaTeX",
      "description": "LaTeX scanner settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "commands": {
          "title": "Section commands",
          "description": "Regex pattern matched against the LaTeX command name. Use `|` to match multiple names. Case-sensitive, no capture groups allowed. Refocus needed.",
          "type": "object",
          "properties": {
            "4": {
              "title": "Level 4 — part",
              "type": "string",
              "default": "part\\*?"
            },
            "5": {
              "title": "Level 5 — chapter",
              "type": "string",
              "default": "chapter\\*?"
            },
            "6": {
              "title": "Level 6 — section",
              "type": "string",
              "default": "section\\*?"
            },
            "7": {
              "title": "Level 7 — subsection",
              "type": "string",
              "default": "subsection\\*?"
            },
            "8": {
              "title": "Level 8 — subsubsection",
              "type": "string",
              "default": "subsubsection\\*?"
            },
            "9": {
              "title": "Level 9 — paragraph",
              "type": "string",
              "default": "paragraph\\*?"
            },
            "10": {
              "title": "Level 10 — subparagraph",
              "type": "string",
              "default": "subparagraph\\*?"
            }
          }
        }
      }
    },
    "sofistik": {
      "title": "SOFiSTiK",
      "description": "SOFiSTiK scanner settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "showInBlock": {
          "title": "Show sections inside define block",
          "description": "Include sections defined inside `#define` blocks in the outline. Refocus needed.",
          "type": "boolean",
          "default": true
        },
        "icons": {
          "title": "Show chapter/program icons",
          "description": "Show clickable icons next to chapters and programs for toggling their state. Refocus needed.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "tasklist": {
      "title": "Tasklist",
      "description": "Tasklist scanner settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "useHeaders": {
          "title": "Use headers as nodes",
          "description": "Show tasklist headers as outline nodes in the navigation list.",
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
